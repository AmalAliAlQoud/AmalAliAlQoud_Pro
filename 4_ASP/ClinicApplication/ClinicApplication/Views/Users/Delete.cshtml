@using ClinicApplication.Domain.Models
@model User

@{
    ViewData["Title"] = "Delete User";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0 fs-5">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete User
                    </h3>
                </div>
                
                <div class="card-body">
                    <div class="alert alert-danger mb-4" role="alert">
                        Are you sure you want to delete this user?
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Name</label>
                        <input type="text" value="@Model.Name" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Username</label>
                        <input type="text" value="@Model.UserName" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="text" value="@Model.Email" class="form-control bg-light" readonly />
                    </div>

                    <form asp-action="Delete"
                          asp-route-Uuid="@Model.Uuid"
                          method="post">
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Delete User
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>