@using ClinicApplication.Domain.Models
@model Patient
@{
    ViewData["Title"] = "Delete Patient";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0 fs-5">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Patient
                    </h3>
                </div>
                
                <div class="card-body">
                    <div class="alert alert-danger mb-4" role="alert">
                        Are you sure you want to delete this Patient?
                    </div>

                    <form asp-action="Delete" method="post">
                        <input asp-for="Uuid" type="hidden" />

                        <div class="text-danger mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control bg-light" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control bg-light" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date_of_Birth" class="form-label fw-bold"></label>
                            <input asp-for="Date_of_Birth" class="form-control bg-light" readonly />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Delete Patient
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}