@using ClinicApplication.Application.Dtos
@model IEnumerable<PrescriptionDto>

@{
    ViewData["Title"] = "Prescriptions";
    int count = 1;
}

<div class="container-fluid px-4 py-3">
    <!-- Card Container -->
    <div class="card shadow-sm border-0 mb-4">
        <!-- Card Header -->
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="bi bi-capsule me-2"></i>Prescriptions Management
            </h5>
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-2">
                <i class="bi bi-plus-lg me-1"></i>New Prescription
            </a>
        </div>

        <!-- Card Body / Table -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th>Medical Record ID</th>
                            <th>Medicine Name</th>
                            <th>Dosage</th>
                            <th class="text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pre in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-secondary">@count</td>
                                <td><span class="badge bg-light text-dark border">@pre.mdRecord_ID</span></td>
                                <td class="fw-semibold">@pre.Medicine_Name</td>
                                <td>@pre.Dosage</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit"
                                           asp-route-Uuid="@pre.Uuid"
                                           class="btn btn-sm btn-warning text-white">
                                            Edit
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-Uuid="@pre.Uuid"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>