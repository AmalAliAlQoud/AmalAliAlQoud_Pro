@using ClinicApplication.Dtos
@model PrescriptionUpdateDto
@{
    ViewData["Title"] = "Edit Prescription";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-warning shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Edit Prescription
                    </h3>
                </div>
                
                <div class="card-body">
                    <div class="alert alert-warning mb-4" role="alert">
                        Are you sure you want to edit this Prescription?
                    </div>

                    <form asp-action="Edit" method="post">
                        <input asp-for="Uuid" type="hidden" />

                        <div class="text-danger mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="mdRecord_ID" class="form-label fw-bold"></label>
                             <select asp-for="mdRecord_ID" class="form-control" asp-items="ViewBag.MRecords" disabled>
                                <option value="">-- Select Medical Record --</option>

                   
                            </select>
                            <input type="hidden" asp-for="mdRecord_ID" />

                            <span class="text-danger" asp-validation-for="mdRecord_ID"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Medicine_Name" class="form-label fw-bold"></label>
                            <input asp-for="Medicine_Name" class="form-control" />
                            <span class="text-danger" asp-validation-for="Medicine_Name"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Dosage" class="form-label fw-bold"></label>
                            <input asp-for="Dosage" class="form-control" />
                            <span class="text-danger" asp-validation-for="Dosage"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold">
                                Update Prescription
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}