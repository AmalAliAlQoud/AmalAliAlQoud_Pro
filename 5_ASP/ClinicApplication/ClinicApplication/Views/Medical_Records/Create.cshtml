@using ClinicApplication.Application.Dtos
@model Medical_RecordCreateDto
@{
    ViewData["Title"] = "Create Medical Record";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-file-earmark-medical me-2"></i>Create New Medical Record
                    </h3>
                </div>
                
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="text-danger mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Patient_ID" class="form-label fw-bold"></label>
                           <select asp-for="Patient_ID" class="form-control" asp-items="ViewBag.Patients">
                                <option value="">-- Select Patien --</option>
                          </select>
                            <span class="text-danger" asp-validation-for="Patient_ID"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor_ID" class="form-label fw-bold"></label>
                            <select asp-for="Doctor_ID" class="form-control" asp-items="ViewBag.Doctors">
                                <option value="">-- Select Doctor --</option>                                             
                            </select>
                            <span class="text-danger" asp-validation-for="Doctor_ID"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Diagnosis" class="form-label fw-bold"></label>
                            <textarea rows="4" asp-for="Diagnosis" class="form-control" placeholder="Enter diagnosis details..."></textarea>
                            <span class="text-danger" asp-validation-for="Diagnosis"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold"></label>
                            <textarea rows="4" asp-for="Notes" class="form-control" placeholder="Enter additional notes..."></textarea>
                            <span class="text-danger" asp-validation-for="Notes"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                Create Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}