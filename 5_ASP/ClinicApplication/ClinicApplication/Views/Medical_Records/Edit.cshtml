@model Medical_Record
@{
    ViewData["Title"] = "Edit Medical Record";
}


<div class="container">
    <h1>update Medical Record</h1>
    <form asp-action="Edit" method="post">
        <div class="form-group">

            <div class="text-danger" asp-validation-summary="All">
            </div>
            <label asp-for="Patient_ID" class="control-label"></label>
            <input asp-for="Patient_ID" class="form-control" />
            <span class="text-danger" asp-validation-for="Patient_ID"></span>


        </div>
        <div class="form-group">
            <label asp-for="Doctor_ID" class="control-label"></label>
            <input asp-for="Doctor_ID" class="form-control" />
            <span class="text-danger" asp-validation-for="Doctor_ID"></span>

        </div>
        <div class="form-group">
            <label asp-for="Diagnosis" class="control-label"></label>
            <input  asp-for="Diagnosis" class="form-control" />
            <span class="text-danger" asp-validation-for="Diagnosis"></span>


        </div>

        <div class="form-group">
            <label asp-for="Notes" class="control-label"></label>
            <input  asp-for="Notes" class="form-control" />
            <span class="text-danger" asp-validation-for="Notes"></span>


        </div>

        
        <div class="form-group">
            <input type="submit" value="Save" class="btn btn-primary" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}