@using ClinicApplication.Dtos
@model Medical_RecordUpdateDto
@{
    ViewData["Title"] = "Delete Medical Record";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0 fs-5">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Medical Record
                    </h3>
                </div>
                
                <div class="card-body">
                    <div class="alert alert-danger mb-4" role="alert">
                        Are you sure you want to delete this medical record?
                    </div>

                    <form asp-action="Delete" method="post">
                        <input asp-for="Uuid" type="hidden" />

                        <div class="text-danger mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Patient_ID" class="form-label fw-bold"></label>
                            <input value="@Model.PatientName" class="form-control" readonly />
                            <input type="hidden" asp-for="Patient_ID" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor_ID" class="form-label fw-bold"></label>
                            <input  value="@Model.DoctorName"  class="form-control" readonly />
                            <input type="hidden" asp-for="Doctor_ID" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Diagnosis" class="form-label fw-bold"></label>
                            <textarea rows="4" asp-for="Diagnosis" class="form-control bg-light" readonly></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold"></label>
                            <textarea rows="4" asp-for="Notes" class="form-control bg-light" readonly></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-danger">
                                Delete Medical Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}