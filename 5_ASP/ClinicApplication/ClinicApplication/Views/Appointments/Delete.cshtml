@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}


<div class="container">
    <h1>Delete Appointment</h1>
    <form asp-action="Delete" method="post">
        <div class="form-group">

            <div class="text-danger" asp-validation-summary="All">
            </div>
            <label asp-for="Patient_ID" class="control-label"></label>
            <input asp-for="Patient_ID" class="form-control" readonly />


        </div>
        <div class="form-group">
            <label asp-for="Doctor_ID" class="control-label"></label>
            <input asp-for="Doctor_ID" class="form-control" readonly />

        </div>
        <div class="form-group">
            <label asp-for="Date" class="control-label"></label>
            <input asp-for="Date" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Time" class="control-label"></label>
            <input asp-for="Time" class="form-control" readonly />
        </div>

        
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Delete">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}