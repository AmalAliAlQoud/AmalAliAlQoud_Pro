@model Appointment
@{
    ViewData["Title"] = "Create Appointment";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-calendar-plus me-2"></i>Create New Appointment
                    </h3>
                </div>
                
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="text-danger mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Patient_ID" class="form-label fw-bold"></label>
                            <input asp-for="Patient_ID" class="form-control" placeholder="Enter Patient ID" />
                            <span class="text-danger" asp-validation-for="Patient_ID"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Doctor_ID" class="form-label fw-bold"></label>
                            <input asp-for="Doctor_ID" class="form-control" placeholder="Enter Doctor ID" />
                            <span class="text-danger" asp-validation-for="Doctor_ID"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date" class="form-label fw-bold"></label>
                            <input type="date" asp-for="Date" class="form-control" />
                            <span class="text-danger" asp-validation-for="Date"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Time" class="form-label fw-bold"></label>
                            <input type="time" asp-for="Time" class="form-control" asp-format="{0:HH:mm}" step="60" />
                            <span class="text-danger" asp-validation-for="Time"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                Create Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}