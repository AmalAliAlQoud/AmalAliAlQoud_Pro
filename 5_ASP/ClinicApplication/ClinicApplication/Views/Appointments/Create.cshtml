@model Appointment
@{
    ViewData["Title"] = "Create Appointment";
}


<div class="container">
    <h1>Create Appointment</h1>
    <form asp-action="Create" method="post">
        <div class="form-group">

            <div class="text-danger" asp-validation-summary="All">
            </div>
            <label asp-for="Patient_ID" class="control-label"></label>
            <input asp-for="Patient_ID" class="form-control" />
            <span class="text-danger" asp-validation-for="Patient_ID"></span>


        </div>
        <div class="form-group">
            <label asp-for="Doctor_ID" class="control-label"></label>
            <input asp-for="Doctor_ID" class="form-control" />
            <span class="text-danger" asp-validation-for="Doctor_ID"></span>

        </div>
        <div class="form-group">
            <label asp-for="Date" class="control-label"></label>
            <input type="date" asp-for="Date" class="form-control" />
            <span class="text-danger" asp-validation-for="Date"></span>


        </div>
        <div class="form-group">
            <label asp-for="Time" class="control-label"></label>
            <input type="time" asp-for="Time" class="form-control" asp-format="{0:HH:mm}" asp-format="{0:HH:mm}" step="60" />
            <span class="text-danger" asp-validation-for="Time"></span>


        </div>

        
        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}