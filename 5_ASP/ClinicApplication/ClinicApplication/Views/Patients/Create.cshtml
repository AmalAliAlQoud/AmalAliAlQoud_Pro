@using ClinicApplication.Domain.Models
@model Patient
@{
    ViewData["Title"] = "Create Patient";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-person-heart me-2"></i>Create New Patient
                    </h3>
                </div>
                
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="text-danger mb-3" asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter patient name" />
                            <span class="text-danger" asp-validation-for="Name"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                            <span class="text-danger" asp-validation-for="Phone"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Date_of_Birth" class="form-label fw-bold"></label>
                            <input type="date" asp-for="Date_of_Birth" class="form-control" />
                            <span class="text-danger" asp-validation-for="Date_of_Birth"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-primary fw-bold">
                                Create Patient
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}