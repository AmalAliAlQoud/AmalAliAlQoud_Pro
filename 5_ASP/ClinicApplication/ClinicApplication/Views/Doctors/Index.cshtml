@model IEnumerable<Doctor>


<div class="container">
    <h1>Doctors</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">New </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Specialty</th>
                <th>Phone</th>
                <th>Actions</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var dr in Model)
            {

                <tr>
                    <td>@dr.Id</td>
                    <td>@dr.Name</td>
                    <td>@dr.Specialty</td>
                    <td>@dr.Phone</td>
                    <td>
                        <a asp-action="Edit" asp-route-Id="@dr.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-Id="@dr.Id" class="btn btn-danger"> Delete  </a>
                    </td>
                </tr>

            }


        </tbody>

    </table>
</div>