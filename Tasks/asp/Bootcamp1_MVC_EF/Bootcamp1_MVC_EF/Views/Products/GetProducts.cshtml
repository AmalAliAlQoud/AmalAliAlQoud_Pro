@model IList<Product>

    
<div class="container mt-5">

    <h2 class="mb-4">Products</h2>

    <table class="table table-striped table-hover table-bordered">

        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Price</td>
                    <td>@product.Quantity</td>

                   
                </tr>
            }




        </tbody>

    </table>

</div>


    